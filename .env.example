# Local Postgres (see docker-compose.yml). On Railway, do not paste a public
# URL — reference the private one:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# or:
#   DATABASE_URL=postgresql://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/${{Postgres.PGDATABASE}}
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/procrastinate

PORT=43122
HOST=0.0.0.0
RAILPACK_PYTHON_VERSION=3.12

# Optional. When set, POST /jobs/demo and GET /jobs require Authorization: Bearer <token>.
# On Railway generate with ${{ secret() }} — never commit a default password.
# JOB_API_TOKEN=

# auto | ipv6 | ipv4  — auto prefers IPv6 for *.railway.internal
PG_PREFER_IPV6=auto
PG_DNS_RETRIES=8
PG_DNS_RETRY_SECONDS=2

LOG_LEVEL=INFO
WORKER_NAME=railway-worker
WORKER_CONCURRENCY=1
